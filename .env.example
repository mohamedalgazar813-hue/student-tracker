# ══════════════════════════════════════════════════════════
#  Student Tracker — Environment Variables
#
#  Vercel:    Project Settings → Environment Variables
#  Local dev: copy this file to ".env" (never commit .env)
# ══════════════════════════════════════════════════════════

# ── REQUIRED ──────────────────────────────────────────────

# MongoDB Atlas connection string
# mongodb.com/atlas → Connect → Drivers → copy string
# Replace <password> and set DB name to: studentTracker
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/studentTracker?retryWrites=true&w=majority

# JWT Secret — long random string (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_long_random_secret_string_minimum_32_characters
