# ══════════════════════════════════════════════
#  Student Tracker — Environment Variables
#  Copy this file to .env for local development
#  Set these variables in Render dashboard for production
# ══════════════════════════════════════════════

# MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/studentTracker?retryWrites=true&w=majority

# JWT secret — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string

# Server port — Render sets this automatically, do NOT change in production
PORT=3000

# CORS — comma-separated list of allowed frontend origins
# Use * to allow all (fine for development, restrict in production)
# Example: https://your-frontend.netlify.app,https://yourdomain.com
ALLOWED_ORIGIN=*
